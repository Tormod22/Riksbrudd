{ "cleanUrls": true, "trailingSlash": false,
  "rewrites": [
    { "source": "/api/kart/:tag/:lag/:fra/:lengde", "destination": "/api/kart?tag=:tag&lag=:lag&fra=:fra&lengde=:lengde" }
  ],
  "headers": [
    { "source": "/((?!api/).*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
    { "source": "/dovre-fliser/lib/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ] }
