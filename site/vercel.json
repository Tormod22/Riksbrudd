{
 "cleanUrls": true,
 "trailingSlash": false,
 "rewrites": [
  {
   "source": "/api/kart/:tag/:fil/:fra/:lengde",
   "destination": "/api/kart?tag=:tag&fil=:fil&fra=:fra&lengde=:lengde"
  },
  {
   "source": "/norge",
   "destination": "/dovre-fliser"
  }
 ],
 "headers": [
  {
   "source": "/((?!api/).*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/dovre-fliser/lib/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/fonter/(.*)\\.woff2",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/norge-1986",
   "destination": "/norge",
   "permanent": false
  }
 ]
}
